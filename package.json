{
  "name": "hennri-maker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"wrangler dev --local --port 8787\" \"vite\"",
    "dev:remote": "concurrently -k -n api,web \"wrangler dev --remote --port 8787\" \"vite\"",
    "build": "vite build",
    "preview": "npm run build && wrangler dev --local",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p . && tsc -p api",
    "db:migrate:local": "wrangler d1 migrations apply hennri-maker-db --local",
    "db:seed:local": "wrangler d1 migrations apply hennri-maker-db --local && wrangler d1 execute hennri-maker-db --local --file seed.local.sql"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "radix-ui": "^1.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  }
}
